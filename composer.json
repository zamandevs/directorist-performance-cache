{
    "name": "zamandevs/directorist-performance-cache",
    "description": "Optional fallback page-cache companion for Directorist.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "~2.1.3",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "php -d xdebug.mode=off vendor/bin/phpunit",
        "phpcs": "vendor/bin/phpcs -p . --standard=phpcs.xml.dist",
        "compat": "vendor/bin/phpcs -p . --standard=PHPCompatibilityWP --severity=1 --runtime-set testVersion 7.4- --extensions=php --ignore=vendor/*,node_modules/*,build/*,dist/*"
    }
}
